# MODENA-vs-LAMMPS validation — Ewald electrostatics on NaCl rocksalt.
# Matched to bench/validation/ewald/modena.toml: same structure (rocksalt,
# a=5.0, 11x11x11 replicas = 10648 atoms), same charges (+1/-1), same Buckingham
# parameters (A=1000, rho=0.3, C=1.0), same cutoff (5.0), same Ewald kappa
# (0.5), same real-space cutoff (5.0), same dt (0.0025), same steps (2000),
# same initial T (0.1), same seed (87287).
#
# LAMMPS pair_style buck/coul/long: Buckingham + long-range Coulomb.
# kspace_style ewald with gewald=0.5 to match MODENA's kappa.
# pair_modify shift yes: energy-shifted (vs MODENA force-shifted) — same
# convention difference as the Buckingham validation.
#
# Structure: two interpenetrating FCC sublattices.
#   Na (type 1) on FCC lattice at a=5.0, density=4/125=0.032.
#   Cl (type 2) on FCC lattice shifted by (a/2,0,0) = (2.5,0,0).
# This reproduces MODENA's rocksalt() builder exactly.

units           lj
atom_style      charge
boundary        p p p

# Box: 11 unit cells per axis, a=5.0, box = 55x55x55 (10648 atoms).
region          box block 0 55 0 55 0 55 units box
create_box      2 box

# Na sublattice (type 1): FCC, a=5.0, density=4/125=0.032.
lattice         fcc 0.032
create_atoms    1 box

# Cl sublattice (type 2): FCC shifted by (a/2,0,0).
# origin 0.5 0 0 shifts by 0.5*lattice_vector = (2.5,0,0) in real space.
lattice         custom 0.032 origin 0.5 0.0 0.0 &
                basis 0 0 0 &
                basis 0.5 0.5 0 &
                basis 0.5 0 0.5 &
                basis 0 0.5 0.5 &
                a1 1 0 0 a2 0 1 0 a3 0 0 1
create_atoms    2 box

# Charges: Na +1, Cl -1 (reduced units, dielectric=1).
set             type 1 charge 1.0
set             type 2 charge -1.0

# Masses (reduced: m=1).
mass            1 1.0
mass            2 1.0

# Buckingham + long-range Coulomb.
# A=1000, rho=0.3, C=1.0 for all pairs. Cutoffs: 5.0 (Buck), 5.0 (Coul real).
pair_style      buck/coul/long 5.0 5.0
pair_coeff      1 1 1000.0 0.3 1.0
pair_coeff      1 2 1000.0 0.3 1.0
pair_coeff      2 2 1000.0 0.3 1.0
pair_modify     shift yes

# Ewald: same kappa as MODENA (0.8, kappa*rc = 4.0 -> erfc = 1.5e-8),
# tight accuracy so the k-space truncation is also negligible.
kspace_style    pppm 1e-5
kspace_modify   gewald 0.8

velocity        all create 0.1 87287 dist gaussian mom yes rot no

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

fix             1 all nve

timestep        0.0025

thermo          100
thermo_style    custom step temp pe ke etotal press
thermo_modify   norm no flush yes

run             2000
